{
    "States": {
        "invoke_lambda_example": {
            "Type": "Task",
            "Parameters": {
                "Payload": {
                    "TASK_TOKEN.$": "$$.Task.Token",
                    "FOO.$": "$.foo"
                },
                "FunctionName": "example-lambda-function"
            },
            "Resource": "arn:aws:states:::lambda:invoke.waitForTaskToken",
            "Next": "map_running_task"
        },
        "map_running_task": {
            "Type": "Map",
            "ItemProcessor": {
                "States": {
                    "run_task_failed": {
                        "Type": "Fail"
                    },
                    "example": {
                        "Catch": [
                            {
                                "ErrorEquals": [
                                    "States.ALL"
                                ],
                                "Next": "run_task_failed"
                            }
                        ],
                        "Type": "Task",
                        "ResultPath": "$.TaskResult",
                        "Parameters": {
                            "TaskDefinition": "example-ecs-task-definition",
                            "LaunchType": "FARGATE",
                            "Overrides": {
                                "ContainerOverrides": [
                                    {
                                        "Name": "example-ecs-task",
                                        "Environment": [
                                            {
                                                "Name": "OBJECTS",
                                                "Value.$": "$.example-consumer-output-key"
                                            },
                                            {
                                                "Name": "TASK_TOKEN",
                                                "Value.$": "$$.TASK_TOKEN"
                                            }
                                        ]
                                    }
                                ]
                            },
                            "Cluster": "example-ecs-cluster",
                            "NetworkConfiguration": {
                                "AwsvpcConfiguration": {
                                    "Subnets": [
                                        "example-subnet-1",
                                        "example-subnet-2",
                                        "example-subnet-3"
                                    ],
                                    "AssignPublicIp": "DISABLE"
                                }
                            }
                        },
                        "Resource": "arn:aws:states:::ecs:runTask.waitForTaskToken",
                        "Next": "run_ecs_success"
                    },
                    "run_ecs_success": {
                        "Type": "Succeed"
                    }
                },
                "StartAt": "example",
                "ProcessorConfig": {
                    "Mode": "INLINE"
                }
            },
            "ItemsPath": "$.example-consumer-output-key",
            "MaxConcurrency": 5,
            "Next": "transform"
        },
        "transform": {
            "Type": "Pass",
            "InputPath": "$.TaskResult",
            "End": true
        }
    },
    "StartAt": "invoke_lambda_example",
    "Comment": "Batch Ingestion",
    "TimeoutSeconds": 60
}