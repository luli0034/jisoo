{
    "States": {
        "ErrorHandler": {
            "Type": "Pass",
            "ResultPath": "$.error_details",
            "Parameters": {
                "error": "Order processing failed"
            },
            "Next": "ProcessOrderFailed"
        },
        "ProcessOrderFailed": {
            "Type": "Fail"
        },
        "ProcessOrders": {
            "Catch": [
                {
                    "ErrorEquals": [
                        "States.TaskFailed",
                        "States.Runtime"
                    ],
                    "Next": "ErrorHandler"
                }
            ],
            "Type": "Map",
            "InputPath": "$.orders",
            "ResultPath": "$.processed_orders",
            "ItemProcessor": {
                "States": {
                    "OrderProcessStart": {
                        "Type": "Pass",
                        "Next": "ProcessOrder"
                    },
                    "ProcessOrder": {
                        "Type": "Task",
                        "Parameters": {
                            "Key": {
                                "foo": {
                                    "S": "bar"
                                }
                            },
                            "TableName": "Orders"
                        },
                        "Resource": "arn:aws:states:::dynamodb:getItem",
                        "Next": "OrderProcessEnd"
                    },
                    "OrderProcessEnd": {
                        "Type": "Pass",
                        "End": true
                    }
                },
                "StartAt": "OrderProcessStart",
                "ProcessorConfig": {
                    "Mode": "INLINE"
                }
            },
            "Next": "AllOrdersProcessed"
        },
        "AllOrdersProcessed": {
            "Type": "Succeed"
        }
    },
    "StartAt": "ProcessOrders",
    "Comment": "Order Processing Workflow"
}